{
  "name": "@silurus/ooxml-site",
  "version": "0.89.7",
  "private": true,
  "type": "module",
  "description": "Showcase / marketing site for @silurus/ooxml",
  "scripts": {
    "predev": "pnpm --filter @silurus/ooxml-legacy-office build && node scripts/copy-samples.mjs",
    "prebuild": "pnpm --filter @silurus/ooxml-legacy-office build && node scripts/copy-samples.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "postbuild": "node ../scripts/build-model-source-sidecars.mjs --out-dir dist/_astro"
  },
  "dependencies": {
    "@silurus/ooxml-core": "workspace:*",
    "@silurus/ooxml-docx": "workspace:*",
    "@silurus/ooxml-pptx": "workspace:*",
    "@silurus/ooxml-xlsx": "workspace:*",
    "@silurus/ooxml-legacy-office": "workspace:*"
  },
  "devDependencies": {
    "astro": "^6.4.8",
    "vite-plugin-wasm": "^3.6.0"
  }
}
