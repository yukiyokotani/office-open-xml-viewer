---
export type DocumentFormat = 'docx' | 'xlsx' | 'pptx';

interface Props {
  selected?: DocumentFormat;
  label?: string;
}

const { selected = 'docx', label = 'Document format' } = Astro.props;
const formats: readonly DocumentFormat[] = ['docx', 'xlsx', 'pptx'];
---
<div class="tabs" role="group" aria-label={label}>
  {formats.map((format) => (
    <button
      class="tab"
      type="button"
      data-format-tab={format}
      aria-pressed={format === selected ? 'true' : 'false'}
    >
      <span class="tab-label">{format.toUpperCase()}</span>
    </button>
  ))}
</div>

<style>
  .tabs {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex: 0 0 auto;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elev-2);
  }
  .tab {
    display: inline-flex;
    align-items: center;
    min-height: 0;
    padding: 6px 10px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--text-dim);
    font: 600 12px var(--mono);
    cursor: pointer;
    transition: color .18s, background .18s;
  }
  .tab:hover { color: var(--text); background: var(--bg-elev); }
  .tab[aria-pressed='true'] {
    color: var(--text);
    background: var(--border);
  }
  .tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
