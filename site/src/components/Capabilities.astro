---
const cols = [
  {
    name: 'DOCX', ext: '.docx', color: 'var(--docx)',
    items: [
      'Paginated layout with headers, footers & sections',
      'Complex tables with borders, fills & merged cells',
      'Inline / anchored images, optional TIFF decoding and DrawingML shapes with image fills',
      'CJK typography: ruby, vertical writing & line grids',
      'Math equations, classic charts and optional ChartEx / 3-D / Region Map rendering',
      'Tracked-change markup, text / element context, progressive virtualized scroll, zoom, find & links',
    ],
  },
  {
    name: 'XLSX', ext: '.xlsx', color: 'var(--xlsx)',
    items: [
      'Multi-sheet workbooks with frozen panes & outlines',
      'Cached formulas, dates and Excel number formats',
      'Classic charts, optional ChartEx / 3-D / Region Maps, sparklines and conditional formatting',
      'Images with optional TIFF decoding, drawing shapes and styled slicers',
      'Pivot metadata, comments and CJK cell text',
      'Multiple-area selection, range / element context, TSV copy, find, internal links, zoom & drag-resize',
    ],
  },
  {
    name: 'PPTX', ext: '.pptx', color: 'var(--pptx)',
    items: [
      'Slide master and layout inheritance',
      'Preset / custom shapes, groups and SmartArt text',
      'Gradient fills, picture effects and 3D shading',
      'Classic combo and stock charts, plus optional ChartEx / 3-D / Region Maps',
      'WordArt, embedded fonts, optional TIFF images, math equations and embedded audio / video',
      'Table text selection, text / element context, progressive virtualized scroll, zoom, find & links',
    ],
  },
];
---
<div class="caps-grid">
  {cols.map((col) => (
    <div class="caps-col" style={`--c:${col.color}`}>
      <div class="caps-head"><span>{col.name}</span><small>{col.ext}</small></div>
      <ul>
        {col.items.map((it) => <li>{it}</li>)}
      </ul>
      <a class="caps-link" href="https://github.com/yukiyokotani/office-open-xml-viewer#feature-support">Full support matrix &#x2197;&#xFE0E;</a>
    </div>
  ))}
</div>

<style>
  .caps-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 0; margin-top: 48px; border-top: 1px solid var(--border-bright); }
  .caps-col {
    grid-column: span 4;
    border-right: 1px solid var(--border);
    padding: 18px 24px 8px 0;
  }
  .caps-col + .caps-col { padding-left: 24px; }
  .caps-col:last-child { border-right: 0; }
  .caps-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; padding-bottom: 18px; border-bottom: 1px solid var(--border); font-weight: 800; font-size: 22px; }
  .caps-head > span {
    display: inline-block;
    background: linear-gradient(transparent 68%, var(--c) 68%, var(--c) 88%, transparent 88%);
  }
  .caps-head small { font: 500 11px var(--mono); color: var(--text-faint); }
  .caps-col ul { list-style: none; margin: 0; padding: 0; }
  .caps-col li {
    position: relative;
    padding: 7px 0 7px 18px;
    font-size: 14px;
    color: var(--text-dim);
    border-bottom: 1px solid var(--border);
  }
  .caps-col li::before { content: ''; position: absolute; left: 0; top: 14px; width: 5px; height: 5px; border-radius: 50%; background: var(--text); }
  .caps-link {
    display: inline-block;
    margin: 14px 0 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-dim);
    border-bottom: 1px solid currentColor;
    transition: opacity 0.15s;
  }
  .caps-link:hover { opacity: 0.75; }
  @media (max-width: 860px) {
    .caps-col { grid-column: span 12; border-right: 0; padding: 28px 0 !important; }
  }
</style>
