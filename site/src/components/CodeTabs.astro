---
import { Code } from 'astro:components';
import { codeThemes } from '../lib/code-theme';

interface Tab {
  id: string;
  label: string;
  lang: string;
  code: string;
}
interface Props {
  id: string;
  tabs: Tab[];
  filename?: string;
}
const { id, tabs, filename } = Astro.props;
---
<div class="codetabs" data-codetabs>
  <div class="ct-head">
    <div class="ct-tabs" role="tablist">
      {tabs.map((t, i) => (
        <button
          id={`${id}-tab-${t.id}`}
          class="ct-tab"
          role="tab"
          data-ct-tab={t.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`${id}-panel-${t.id}`}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.label}
        </button>
      ))}
    </div>
    {filename && <span class="ct-file">{filename}</span>}
    <button class="ct-copy" data-ct-copy aria-label="Copy code">
      <span class="ct-copy-default">Copy</span>
      <span class="ct-copy-done" aria-live="polite"></span>
    </button>
  </div>
  {tabs.map((t, i) => (
    <div
      id={`${id}-panel-${t.id}`}
      class="ct-panel"
      role="tabpanel"
      aria-labelledby={`${id}-tab-${t.id}`}
      data-ct-panel={t.id}
      hidden={i !== 0}
      data-code={t.code}
    >
      <Code code={t.code} lang={t.lang as any} themes={codeThemes} defaultColor={false} />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-codetabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ct-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-ct-panel]'));
    const copy = root.querySelector<HTMLButtonElement>('[data-ct-copy]');

    function select(id: string, focus = false): void {
      tabs.forEach((tab) => {
        const selected = tab.dataset.ctTab === id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.ctPanel !== id; });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.ctTab as string));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(tabs[next]?.dataset.ctTab as string, true);
      });
    });

    copy?.addEventListener('click', async () => {
      const active = panels.find((p) => !p.hidden);
      if (!active) return;
      try {
        await navigator.clipboard.writeText(active.dataset.code ?? '');
        copy.classList.add('done');
        const status = copy.querySelector<HTMLElement>('.ct-copy-done');
        if (status) status.textContent = 'Copied.';
        setTimeout(() => copy.classList.remove('done'), 1400);
      } catch {
        const status = copy.querySelector<HTMLElement>('.ct-copy-done');
        if (status) status.textContent = 'Copy failed. Select the code and copy it manually.';
        copy.classList.add('done');
      }
    });
  });
</script>

<style>
  .codetabs {
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--code-bg);
  }
  .ct-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px 6px 10px;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }
  .ct-tabs { display: flex; gap: 2px; flex-wrap: wrap; }
  .ct-tab {
    appearance: none;
    border: none;
    background: transparent;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    padding: 7px 13px;
    border-radius: 8px;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .ct-tab:hover { color: var(--text-dim); }
  .ct-tab[aria-selected='true'] { color: var(--text); background: var(--bg-elev-2); }
  .ct-file {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
    margin-left: 6px;
  }
  .ct-copy {
    margin-left: auto;
    appearance: none;
    border: 1px solid var(--border-bright);
    background: var(--bg-elev-2);
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    position: relative;
    transition: border-color 0.15s, color 0.15s;
  }
  .ct-copy:hover { color: var(--text); border-color: var(--accent); }
  .ct-copy-done { display: none; color: var(--accent); }
  .ct-copy.done .ct-copy-default { display: none; }
  .ct-copy.done .ct-copy-done { display: inline; }

  .ct-panel :global(pre) {
    margin: 0;
    padding: 18px 20px;
    background: var(--code-bg) !important;
    font-size: 13.5px;
    line-height: 1.65;
    overflow-x: auto;
  }
  .ct-panel :global(code) { font-family: var(--mono); }
</style>
