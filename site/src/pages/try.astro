---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import BrandIcon from '../components/BrandIcon.astro';
---
<Base title="Try your own file — @silurus/ooxml" canonicalPath="/try/">
  <Nav />

  <main class="wrap try-workspace">
    <aside class="try-sidebar">
      <div class="try-copy">
        <p class="eyebrow">Try yours</p>
        <h1 class="try-title">Drop in a file.<br />See how it renders.</h1>
        <p class="try-lead">DOCX, XLSX and PPTX are parsed and rendered locally in your browser. Your file is never uploaded.</p>
      </div>

      <input type="file" id="file" accept=".docx,.xlsx,.pptx,.csv,.tsv" hidden />
      <button class="dropzone" id="dropzone" type="button">
        <span class="dz-action"><strong>Choose or drop a file</strong><small>.docx · .xlsx · .pptx</small></span>
        <span class="dz-arrow" aria-hidden="true">＋</span>
      </button>

      <div class="try-status" id="status" hidden></div>
      <div class="try-privacy">
        <span>Privacy</span>
        <p>No file leaves your device. <a href="https://github.com/yukiyokotani/office-open-xml-viewer">View source &#x2197;&#xFE0E;</a></p>
      </div>
    </aside>

    <section class="try-preview" aria-label="Document preview">
      <div class="try-empty" id="empty" aria-hidden="true"></div>
      <div class="try-panel" id="panel" hidden>
        <div class="try-panel-head">
          <span class="try-file" id="panel-file"></span>
          <span class="panel-badge" id="wasm-badge">live · WASM</span>
          <button class="try-reset" id="reset">Choose another file</button>
        </div>
        <div class="try-stage-shell">
          <div class="try-stage" id="stage"></div>
          <div class="try-stage-progress" id="stage-progress" role="status" aria-live="polite" hidden>
            <span class="try-progress-circle" aria-hidden="true"></span>
            <span>Parsing document…</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <BrandIcon />
        <div>
          <strong>@silurus/ooxml</strong>
          <span>Browser-based OOXML viewer · Rust/WASM + Canvas</span>
        </div>
      </div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/announcements">Announcements</a>
        <a href="https://www.npmjs.com/package/@silurus/ooxml">npm</a>
        <a href="https://github.com/yukiyokotani/office-open-xml-viewer">GitHub</a>
      </div>
    </div>
  </footer>

  <script>
    import {
      disposeRenderedFile,
      isTryYoursDelimitedTextFile,
      renderFile,
      prewarmEngines,
    } from '../lib/try';
    // Hot standby — prime the WASM engines + fonts on idle so the first dropped
    // file renders without the cold parser-load cost.
    prewarmEngines();
    const dz = document.getElementById('dropzone') as HTMLButtonElement;
    const input = document.getElementById('file') as HTMLInputElement;
    const empty = document.getElementById('empty') as HTMLElement;
    const preview = document.querySelector<HTMLElement>('.try-preview')!;
    const status = document.getElementById('status') as HTMLElement;
    const panel = document.getElementById('panel') as HTMLElement;
    const stage = document.getElementById('stage') as HTMLElement;
    const stageProgress = document.getElementById('stage-progress') as HTMLElement;
    const fileLabel = document.getElementById('panel-file') as HTMLElement;
    const wasmBadge = document.getElementById('wasm-badge') as HTMLElement;
    const reset = document.getElementById('reset') as HTMLButtonElement;
    let loadGeneration = 0;

    async function handle(file: File): Promise<void> {
      const generation = ++loadGeneration;
      status.hidden = false;
      status.classList.remove('error');
      status.textContent = `Parsing ${file.name}…`;
      // Keep the panel in layout while rendering so ScrollViewer observes the
      // real preview viewport before its first paint.
      panel.hidden = false;
      empty.hidden = true;
      wasmBadge.hidden = isTryYoursDelimitedTextFile(file.name);
      panel.classList.add('loading');
      stage.style.visibility = 'hidden';
      stageProgress.hidden = false;
      try {
        const t0 = performance.now();
        const res = await renderFile(stage, file, ({ units, unitLabel }) => {
          if (generation !== loadGeneration) return;
          const elapsed = Math.round(performance.now() - t0);
          const count = `${units} ${unitLabel}${units === 1 ? '' : 's'} · `;
          status.textContent = `${count}available · loading for ${elapsed} ms`;
        });
        if (generation !== loadGeneration) return;
        preview.dataset.format = res.format;
        const ms = Math.round(performance.now() - t0);
        const count = res.units ? `${res.units} ${res.unitLabel}${res.units === 1 ? '' : 's'} · ` : '';
        fileLabel.textContent = file.name;
        panel.classList.remove('loading');
        stage.style.visibility = '';
        stageProgress.hidden = true;
        status.textContent = res.finalUnits
          ? `${count}available · opened in ${ms} ms`
          : `${count}rendered in ${ms} ms`;
        status.hidden = false;
        if (res.finalUnits) {
          void res.finalUnits.then((units) => {
            if (generation !== loadGeneration) return;
            const finalMs = Math.round(performance.now() - t0);
            const finalCount = `${units} ${res.unitLabel}${units === 1 ? '' : 's'} · `;
            status.textContent = `${finalCount}rendered in ${finalMs} ms`;
          }).catch((error) => {
            if (generation !== loadGeneration || (error instanceof Error && error.name === 'AbortError')) return;
            status.classList.add('error');
            status.textContent = error instanceof Error ? error.message : String(error);
          });
        }
      } catch (e) {
        // A later selection owns the shared status/panel UI. The superseded load
        // has already destroyed its viewer in renderFile; it must not hide or
        // overwrite the newer result.
        if (generation !== loadGeneration) return;
        panel.classList.remove('loading');
        stage.style.visibility = '';
        stageProgress.hidden = true;
        status.classList.add('error');
        status.textContent = e instanceof Error ? e.message : String(e);
        panel.hidden = true;
        delete preview.dataset.format;
        empty.hidden = false;
      }
    }

    // Reset the value after capturing the file so re-selecting the SAME file
    // fires `change` again. Returning to this page via browser back/forward
    // reloads it but Chromium restores the file input's value to the previously
    // chosen file; without this reset, re-picking that same file emits no
    // `change` event and nothing renders.
    input.addEventListener('change', () => {
      const f = input.files?.[0];
      input.value = '';
      if (f) void handle(f);
    });
    dz.addEventListener('click', () => input.click());
    ['dragenter', 'dragover'].forEach((ev) =>
      dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.add('over'); }));
    ['dragleave', 'drop'].forEach((ev) =>
      dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.remove('over'); }));
    dz.addEventListener('drop', (e) => {
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) void handle(f);
    });
    reset.addEventListener('click', () => { input.value = ''; input.click(); });
    window.addEventListener('pagehide', (event) => {
      if (event.persisted) return;
      disposeRenderedFile();
    });
  </script>
</Base>

<style>
  .try-workspace {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 18px;
    min-height: calc(100vh - 68px);
    padding-top: 32px;
    padding-bottom: 32px;
  }
  .try-sidebar { grid-column: 1 / 4; display: flex; flex-direction: column; min-width: 0; }
  .try-title { margin-top: 18px; font-size: clamp(34px, 4.1vw, 56px); font-weight: 700; letter-spacing: -.06em; }
  .try-lead { margin: 22px 0 0; max-width: 30ch; font-size: 14px; color: var(--text-dim); }
  .dropzone {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 26px;
    gap: 12px;
    align-items: center;
    margin-top: 52px;
    padding: 14px 16px;
    appearance: none;
    border: 1px solid var(--border-bright);
    background: var(--bg-elev);
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background .18s, border-color .18s;
  }
  .dropzone:hover, .dropzone.over { background: var(--signal-wash); border-color: var(--accent); }
  .dropzone:focus-visible { outline: 3px solid var(--selection-bg); outline-offset: 3px; }
  .dz-action { display: grid; gap: 4px; }
  .dz-action strong { font-size: 14px; }
  .dz-action small { font: 500 10px var(--mono); color: var(--text-faint); }
  .dz-arrow {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    justify-self: end;
    background: var(--signal);
    color: var(--signal-text);
    font-size: 13px;
  }
  .try-status {
    margin-top: 14px;
    padding: 10px 12px;
    background: var(--bg-elev-2);
    font: 500 11px var(--mono);
    color: var(--text-dim);
  }
  .try-status.error { color: var(--accent-3); }
  .try-privacy { margin-top: auto; padding-top: 24px; border-top: 1px solid var(--border); }
  .try-privacy > span { font: 500 10px var(--mono); letter-spacing: .08em; color: var(--text-faint); text-transform: uppercase; }
  .try-privacy p { margin: 8px 0 0; font-size: 12px; color: var(--text-dim); }
  .try-privacy a { color: var(--accent); }
  .try-preview {
    grid-column: 4 / 13;
    height: calc(100vh - 132px);
    min-height: 560px;
    border: 1px solid var(--border);
    background: radial-gradient(120% 80% at 50% 0%, var(--preview-top), var(--preview-bottom) 70%);
    overflow: hidden;
  }
  .try-empty { height: 100%; }
  .try-empty[hidden] { display: none; }
  .try-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
  .try-panel[hidden] { display: none; }
  .try-panel-head {
    display: flex; align-items: center; gap: 12px;
    min-height: 52px; padding: 9px 14px; border-bottom: 1px solid var(--border); background: var(--bg-elev);
  }
  .try-file { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 12px var(--mono); color: var(--text-dim); }
  .panel-badge {
    flex: 0 0 auto; font: 500 10px var(--mono); color: var(--accent);
    border: 1px solid var(--border-bright); padding: 3px 8px;
  }
  .try-reset {
    flex: 0 0 auto; margin-left: auto; appearance: none; cursor: pointer;
    background: var(--signal); border: 1px solid var(--signal); color: var(--signal-text);
    font: 600 11px var(--mono); padding: 6px 10px; transition: filter .15s;
  }
  .try-reset:hover { filter: brightness(.92); }
  .try-stage-shell { position: relative; flex: 1; min-height: 0; }
  .try-stage { height: 100%; }
  .try-panel.loading .try-stage-shell { background: radial-gradient(120% 80% at 50% 0%, var(--preview-top), var(--preview-bottom) 70%); }
  .try-stage-progress {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    color: var(--preview-text); font-family: var(--mono); font-size: 12px;
  }
  .try-stage-progress[hidden] { display: none; }
  .try-progress-circle {
    width: 34px; height: 34px; box-sizing: border-box; border-radius: 50%;
    border: 3px solid var(--border-bright); border-top-color: var(--signal);
    animation: try-progress-spin 0.8s linear infinite;
  }
  @keyframes try-progress-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .try-progress-circle { animation: none; }
  }
  .try-stage :global(.lv-scroll-viewer), .try-stage :global(.lv-xlsx) { height: 100%; border-radius: 0; }
  .try-stage :global(.lv-scroll-viewer) {
    width: 100%;
    background: radial-gradient(120% 80% at 50% 0%, var(--preview-top), var(--preview-bottom) 70%);
  }
  .try-stage :global(.lv-scroll-viewer canvas) { border-radius: 4px; }
  :global(.footer) { margin-top: 0; }
  @media (max-width: 820px) {
    .try-workspace { display: block; min-height: 0; padding-top: 40px; }
    .try-sidebar { display: block; }
    .try-lead { max-width: 52ch; }
    .dropzone { margin-top: 32px; }
    .try-privacy { margin-top: 24px; }
    .try-preview { height: min(72vh, 680px); min-height: 460px; margin-top: 28px; }
  }
</style>
