---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base
  title="Bundle size — @silurus/ooxml"
  description="Current production bundle-size measurements for @silurus/ooxml."
  canonicalPath="/bundle-size/"
>
  <Nav />
  <main>
    <header class="size-hero">
      <div class="wrap">
        <p class="eyebrow">Current measurement</p>
        <h1>Bundle size.</h1>
        <p>Current production assets for v0.89.7.</p>
      </div>
    </header>

    <section class="wrap size-content">
      <div class="size-table-wrap">
        <table>
          <thead>
            <tr><th>Configuration</th><th>Raw</th><th>gzip</th></tr>
          </thead>
          <tbody>
            <tr>
              <th>DOCX static JavaScript</th>
              <td>3,090 KiB</td>
              <td>704 KiB</td>
            </tr>
            <tr>
              <th>XLSX static JavaScript</th>
              <td>2,123 KiB</td>
              <td>459 KiB</td>
            </tr>
            <tr>
              <th>PPTX static JavaScript</th>
              <td>2,128 KiB</td>
              <td>461 KiB</td>
            </tr>
          </tbody>
        </table>
      </div>
      <h2>Optional modules</h2>
      <div class="size-table-wrap">
        <table>
          <thead>
            <tr><th>Configuration</th><th>Raw</th><th>gzip</th></tr>
          </thead>
          <tbody>
            <tr><th>ChartEx</th><td>39.7 KiB</td><td>12.2 KiB</td></tr>
            <tr><th>3-D charts</th><td>106.2 KiB</td><td>30.1 KiB</td></tr>
            <tr><th>Region Map</th><td>231.2 KiB</td><td>62.6 KiB</td></tr>
            <tr><th>Math adapter</th><td>1.2 KiB</td><td>0.6 KiB</td></tr>
            <tr><th>TIFF image codec</th><td>27.4 KiB</td><td>8.2 KiB</td></tr>
          </tbody>
        </table>
      </div>
      <h2>Optional add-on package</h2>
      <p>
        Experimental <code>@silurus/ooxml-legacy-office</code> v0.89.7 assets, measured separately
        from the viewer totals above. Entry rows exclude the add-on's shared helper, counted
        once below, and the viewer peer. Creating a source fetches nothing; its reader module and
        dedicated WASM load only for a claimed file. Ordinary OOXML imports include none of these
        readers. <a href="/legacy-office">See legacy Office loading and deployment →</a>
      </p>
      <div class="size-table-wrap">
        <table>
          <thead><tr><th>Add-on asset</th><th>Raw</th><th>gzip</th></tr></thead>
          <tbody>
            <tr><th>DOC entry (/doc)</th><td>0.6 KiB</td><td>0.4 KiB</td></tr>
            <tr><th>XLS entry (/xls)</th><td>0.5 KiB</td><td>0.3 KiB</td></tr>
            <tr><th>PPT entry (/ppt)</th><td>0.5 KiB</td><td>0.3 KiB</td></tr>
            <tr><th>Shared source helper</th><td>5.3 KiB</td><td>2.1 KiB</td></tr>
            <tr><th>DOC reader module</th><td>10.8 KiB</td><td>4.1 KiB</td></tr>
            <tr><th>XLS reader module</th><td>10.4 KiB</td><td>4.0 KiB</td></tr>
            <tr><th>PPT reader module</th><td>10.1 KiB</td><td>3.9 KiB</td></tr>
            <tr><th>DOC reader WASM</th><td>1,209.5 KiB</td><td>489.7 KiB</td></tr>
            <tr><th>XLS reader WASM</th><td>1,235.9 KiB</td><td>508.3 KiB</td></tr>
            <tr><th>PPT reader WASM</th><td>1,359.7 KiB</td><td>573.0 KiB</td></tr>
          </tbody>
        </table>
      </div>
      <h2>Runtime assets</h2>
      <div class="size-table-wrap">
        <table>
          <thead>
            <tr><th>Asset</th><th>Raw</th><th>gzip</th></tr>
          </thead>
          <tbody>
            <tr><th>DOCX parser WASM</th><td>2,207 KiB</td><td>925 KiB</td></tr>
            <tr><th>XLSX parser WASM</th><td>1,881 KiB</td><td>780 KiB</td></tr>
            <tr><th>PPTX parser WASM</th><td>1,947 KiB</td><td>784 KiB</td></tr>
            <tr><th>MathJax runtime</th><td>3,846 KiB</td><td>1,269 KiB</td></tr>
          </tbody>
        </table>
      </div>
      <p>
        Static JavaScript is the complete synchronous import graph for each format entry. Optional
        rows show the extra entry asset after shared imports already present in a format graph.
        Parser WASM, MathJax, workers, and the built-in comment UI load separately; the comment UI
        is fetched only when it is needed. gzip is measured per emitted asset at level 9. Actual
        application bundles vary by bundler and imported entries. This page is refreshed for each
        release.
      </p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .size-hero { padding: 100px 0 72px; background: var(--hero-bg); color: var(--hero-text); }
  .size-hero .eyebrow { color: var(--hero-text); }
  .size-hero h1 { margin: 18px 0 20px; font-size: clamp(52px, 8vw, 92px); letter-spacing: -.06em; }
  .size-hero p:last-child { max-width: 46ch; margin: 0; color: var(--hero-muted); font-size: 18px; }
  .size-content { padding-top: 56px; padding-bottom: 96px; }
  .size-content h2 { margin: 48px 0 16px; font-size: 24px; letter-spacing: -.02em; }
  .size-table-wrap { overflow-x: auto; border-top: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 20px 16px; border-bottom: 1px solid var(--border); text-align: left; }
  th { font-weight: 700; }
  thead th { color: var(--text-faint); font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  tbody td { font-family: var(--mono); white-space: nowrap; }
  .size-content > p { max-width: 68ch; margin: 28px 0 0; color: var(--text-dim); }
  @media (max-width: 640px) {
    .size-hero { padding: 76px 0 56px; }
    th, td { padding: 16px 12px; }
  }
</style>
