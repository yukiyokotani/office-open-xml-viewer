---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { codeThemes } from '../lib/code-theme';

const fullGuide = 'https://github.com/yukiyokotani/office-open-xml-viewer/blob/main/docs/opendocument.md';
const install = 'npm i @silurus/ooxml @silurus/ooxml-opendocument';
const browserExamples = [
  {
    title: 'ODP → PPTX Viewer',
    code: `import { PptxViewer } from '@silurus/ooxml/pptx';
import { odp } from '@silurus/ooxml-opendocument/odp';

const canvas = document.querySelector('#presentation') as HTMLCanvasElement;
const viewer = new PptxViewer(canvas, { odp });
await viewer.load(await file.arrayBuffer()); // .odp, .otp or .pptx
// When the preview is removed:
viewer.destroy();`,
  },
  {
    title: 'ODT → DOCX Viewer',
    code: `import { DocxViewer } from '@silurus/ooxml/docx';
import { odt } from '@silurus/ooxml-opendocument/odt';

const canvas = document.querySelector('#document') as HTMLCanvasElement;
const viewer = new DocxViewer(canvas, { odt });
await viewer.load(await file.arrayBuffer()); // .odt, .ott or .docx
// When the preview is removed:
viewer.destroy();`,
  },
  {
    title: 'ODS → XLSX Viewer',
    code: `import { XlsxViewer } from '@silurus/ooxml/xlsx';
import { ods } from '@silurus/ooxml-opendocument/ods';

const container = document.querySelector('#workbook') as HTMLElement;
const viewer = new XlsxViewer(container, { ods });
await viewer.load(await file.arrayBuffer()); // .ods, .ots or .xlsx
// When the preview is removed:
viewer.destroy();`,
  },
];
const nodeExample = `import { readFile } from 'node:fs/promises';
import { openPptxPresentation } from '@silurus/ooxml/node';
import { odp } from '@silurus/ooxml-opendocument/odp';

const session = await openPptxPresentation(await readFile('deck.odp'), { odp });
try {
  for await (const slide of session.slides()) {
    // Consume each ordinary slide model in your application.
  }
} finally {
  await session.close();
}`;
const assetExample = `import { createOdp } from '@silurus/ooxml-opendocument/odp';

const odp = createOdp({
  moduleUrl: new URL('/assets/odp-source-module.mjs', location.href).href,
  wasmUrl: new URL('/assets/opendocument_odp_bg.wasm', location.href).href,
});
const viewer = new PptxViewer(canvas, { odp });`;
const formats = [
  ['ODP, OTP', '@silurus/ooxml-opendocument/odp', 'odp', 'createOdp()', 'PptxViewer, PptxScrollViewer, PptxPresentation.load, openPptxPresentation, materializePptxPresentation', 'odp-source-module.mjs, opendocument_odp_bg.wasm'],
  ['ODT, OTT', '@silurus/ooxml-opendocument/odt', 'odt', 'createOdt()', 'DocxViewer, DocxScrollViewer, DocxDocument.load, openDocxDocument, materializeDocxDocument', 'odt-source-module.mjs, opendocument_odt_bg.wasm'],
  ['ODS, OTS', '@silurus/ooxml-opendocument/ods', 'ods', 'createOds()', 'XlsxViewer, XlsxWorkbook.load, openXlsxWorkbook, materializeXlsxWorkbook', 'ods-source-module.mjs, opendocument_ods_bg.wasm'],
];
---

<Base
  title="OpenDocument files | @silurus/ooxml"
  description="Open ODP presentations, ODT documents and ODS spreadsheets in the PPTX, DOCX and XLSX viewers through the optional, experimental @silurus/ooxml-opendocument add-on."
  canonicalPath="/opendocument/"
>
  <Nav active="opendocument" />
  <header class="guide-hero">
    <div class="wrap">
      <p class="eyebrow">Optional add-on · experimental</p>
      <h1>OpenDocument files.</h1>
      <p>Show .odp presentations, .odt documents and .ods spreadsheets with the same viewers you use for PPTX, DOCX and XLSX.</p>
    </div>
  </header>
  <main class="wrap guide-layout">
    <aside aria-label="OpenDocument guide contents">
      <p>Contents</p>
      <nav>
        <a href="#install">Install</a>
        <a href="#browser">Browser viewers</a>
        <a href="#node">Node sessions</a>
        <a href="#loading">Assets and CSP</a>
        <a href="#policy">Rendering policy</a>
        <a href="#odp">What ODP reads</a>
        <a href="#odt-ods">ODT and ODS</a>
        <a href="#errors">Failures</a>
      </nav>
    </aside>
    <div class="guide-content">
      <section id="install">
        <p class="section-label">Install</p>
        <h2>An experimental opt-in.</h2>
        <p>The separate <code>@silurus/ooxml-opendocument</code> package adds experimental reading of
          OpenDocument presentations, text documents and spreadsheets. Each reader maps the package
          directly into the existing PPTX slide, DOCX document or XLSX workbook model; the ordinary
          layout and Canvas renderers draw it. No intermediate OOXML package is generated.</p>
        <div class="code-card"><Code code={install} lang="sh" themes={codeThemes} defaultColor={false} /></div>
        <p>The package versions must match exactly. The add-on pins its <code>@silurus/ooxml</code> peer
          to the same version; upgrade both together. A stale runtime or model-source protocol fails
          before input loading with <code>CompanionRuntimeMismatchError</code>
          (<code>code: 'companion-runtime-mismatch'</code>).</p>
        <p>Applications that do not opt in need no change. Ordinary viewer imports do not import,
          fetch or initialize an OpenDocument reader.</p>
      </section>

      <section id="browser">
        <p class="section-label">Browser viewers</p>
        <h2>Enable each format explicitly.</h2>
        <p>Import a reader and pass it as its own option: <code>&#123; odp &#125;</code> to the PPTX viewers
          and loaders, <code>&#123; odt &#125;</code> to the DOCX ones and <code>&#123; ods &#125;</code> to the
          XLSX ones. Each reader enables its own family only. OOXML input passed to the same viewer
          continues through the ordinary parser.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Input</th><th>Entry</th><th>Reader / factory</th><th>Loaders and viewers</th></tr></thead>
            <tbody>
              {formats.map(([input, entry, reader, factory, loaders]) => (
                <tr><th>{input}</th><td><code>{entry}</code></td><td><code>{reader}</code> / <code>{factory}</code></td><td>{loaders}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        {browserExamples.map(({ title, code }) => (
          <><h3>{title}</h3><div class="code-card"><Code code={code} lang="ts" themes={codeThemes} defaultColor={false} /></div></>
        ))}
      </section>

      <section id="node">
        <p class="section-label">Node sessions</p>
        <h2>Use the same reader in a bounded session.</h2>
        <div class="code-card"><Code code={nodeExample} lang="ts" themes={codeThemes} defaultColor={false} /></div>
        <p><code>openDocxDocument</code> with <code>&#123; odt &#125;</code>, <code>openXlsxWorkbook</code>
          with <code>&#123; ods &#125;</code> and the materialization APIs accept the readers the same way.
          Close sessions in <code>finally</code>.</p>
      </section>

      <section id="loading">
        <p class="section-label">Assets and CSP</p>
        <h2>Pay for the reader only when used.</h2>
        <p>Importing an entry or calling its factory fetches nothing. When a matching file is opened,
          the parser Worker (or Node) imports the reader's self-contained ES source module and its WASM:</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Reader</th><th>Assets</th></tr></thead>
            <tbody>
              {formats.map(([, , reader, , , assets]) => (
                <tr><th><code>{reader}</code></th><td><code>{assets}</code></td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>Serve these files with the other package assets and allow the source module URL in your
          Content Security Policy for scripts and Worker imports. When an asset pipeline relocates the
          files, create the reader with <code>createOdp</code>, <code>createOdt</code> or
          <code>createOds</code> and absolute <code>moduleUrl</code> and <code>wasmUrl</code> options, and
          pass it as the same option.</p>
        <div class="code-card"><Code code={assetExample} lang="ts" themes={codeThemes} defaultColor={false} /></div>
      </section>

      <section id="policy">
        <p class="section-label">Rendering policy</p>
        <h2>Best effort, LibreOffice as the reference.</h2>
        <p>The readers aim to render every OpenDocument feature they read. Each one is read as ODF 1.3
          specifies and mapped onto the target model; where the specification leaves a choice to the
          consumer, or LibreOffice reads it differently, LibreOffice is the reference. Where the target
          model has no exact counterpart, a feature is drawn with its nearest equivalent instead of
          refusing the document, so a document may show differences from LibreOffice.</p>
        <p>A few features are not drawn at all, and are listed as known differences in the full reference:
          for example section backgrounds, character shadows, outlines, reliefs and overlines in ODT, and
          dimension lines, regular polygons and form controls in ODS. Unsupported features never make a
          document reject.</p>
        <p>A document is rejected only when it is corrupt, encrypted or unsafe, or when it exceeds a
          resource limit. The readers never execute scripts, macros or forms, and never fetch external
          resources: linked files outside the package are not drawn.</p>
        <p>A source claims a package only by its <code>mimetype</code> file, so admission inspects the bytes,
          not the filename. Other inputs, including other OpenDocument families, continue on the OOXML
          path unchanged. The ZIP is read with the same structural checks and inflation limits as OOXML
          packages, including your <code>resourceLimits</code>.</p>
      </section>

      <section id="odp">
        <p class="section-label">Presentations</p>
        <h2>What ODP reads.</h2>
        <p>The ODP reader maps a presentation into the PPTX slide model; LibreOffice Impress is the
          reference where ODF leaves a choice. It reads:</p>
        <ul>
          <li><strong>Slides and master pages:</strong> master background objects; header, footer,
            date/time and page-number frames with the slide's display settings; slide and master
            backgrounds; hidden slides and speaker notes.</li>
          <li><strong>Styles:</strong> the cascade of graphic and presentation styles, including per-level
            outline styles of outline placeholders; paragraph, text and list styles with indents, bullet
            characters, pictures and number labels.</li>
          <li><strong>Shapes:</strong> custom shapes from their enhanced geometry (formulas, modifiers,
            every path command, text areas, mirroring), rectangles, ellipses and arcs, polygons, paths,
            lines, connectors, captions, groups, transforms and shape hyperlinks.</li>
          <li><strong>Fills and lines:</strong> solid fills, every gradient style with borders and
            multi-colour stops, uniform and gradient transparency, hatches as the nearest pattern, bitmaps
            stretched, tiled or placed once; dashes, caps, joins and markers; shadows, glow and soft edges.</li>
          <li><strong>Text:</strong> fonts per script, sizes, weight, posture, colours including automatic
            colour, underline and strike-through, raised and lowered text, capitals, letter spacing,
            highlighting, outline and shadowed text, tabs, line breaks, fields and hyperlinks; paragraph
            alignment, indents, spacing, line height, tab stops, columns, anchoring, padding, wrapping and
            shrink-on-overflow.</li>
          <li><strong>Pictures and objects:</strong> cropping, mirroring, colour modes, luminance and
            contrast, transparency; StarView metafile pictures (converted to SVG); embedded and OLE objects
            through their replacement pictures; tables with column widths, row heights, spans, cell fills,
            borders and templates.</li>
          <li><strong>Charts:</strong> <code>office:chart</code> objects are read with their own data table
            into the shared chart model; a structurally invalid chart is drawn from its replacement picture.</li>
        </ul>
        <p>Animations and transitions are not played. Text follows the fonts available to the browser, so
          text set in fonts LibreOffice substitutes can wrap differently. Pair the reader with
          <a href="/fonts">font sources</a> to serve the faces your decks use.</p>
      </section>

      <section id="odt-ods">
        <p class="section-label">Text and spreadsheets</p>
        <h2>ODT and ODS.</h2>
        <p><strong>ODT</strong> maps into the DOCX document model: paragraphs, headings and fields, character
          and paragraph properties, every list and outline numbering style, page styles with headers,
          footers and columns, sections, footnotes and endnotes, tables, drawings, pictures and formula
          objects, drawn as math when you also pass the opt-in <code>math</code> engine
          (<code>import &#123; math &#125; from '@silurus/ooxml/math'</code>, then <code>&#123; odt, math &#125;</code>);
          without it, formulas are skipped as OOXML equations are. Page number and page count are computed by the layout; other fields show
          their stored value, and tracked changes show their accepted state.</p>
        <p><strong>ODS</strong> maps into the XLSX workbook model: tables as sheets, cell values and the
          cached value of formula cells (formulas are kept as text and never calculated), merged cells,
          cell and data styles, named ranges, validations, conditional formats, sparklines, pictures,
          shapes and embedded charts. Page layout, headers and footers are not shown, because the workbook
          viewer shows the grid rather than printed pages. Rows and columns beyond the workbook grid
          (1,048,576 rows and 16,384 columns) are not shown, as when LibreOffice saves such a table as a workbook.</p>
        <p><a href={fullGuide}>Read the full feature lists, LibreOffice compatibility rules and known differences on GitHub →</a></p>
      </section>

      <section id="errors">
        <p class="section-label">Failures</p>
        <h2>Failures and limits.</h2>
        <p>Once a reader claims a file, its failure rejects the load. There is no retry through another
          source or the OOXML parser.</p>
        <ul>
          <li>Encrypted packages reject with <code>OoxmlError</code>,
            <code>code === 'unsupported-encryption'</code>.</li>
          <li>Packages over the ZIP and package limits, including your <code>resourceLimits</code>, reject
            with <code>OoxmlResourceLimitError</code> (<code>code === 'ooxml-resource-limit'</code>).</li>
          <li>A document over the reader's memory or work budget, or over a count bound such as 10,000 slides
            or 8 million materialized cells, rejects with an error whose message names the limit. Many
            per-element bounds (for example nesting depth, gradient stops or shape formula work) clamp or
            drop only the content beyond them, without rejecting the document.</li>
          <li>A stale viewer/add-on combination fails before input loading with
            <code>companion-runtime-mismatch</code>.</li>
        </ul>
        <p>Branch on <code>error.code</code>, not on message text, and show other failures as a generic
          “could not open this file” result.</p>
        <p><a href="/errors">Error delivery and application messages →</a> · <a href={fullGuide}>Full OpenDocument reference →</a></p>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .guide-hero { padding: 80px 0 56px; border-bottom: 1px solid var(--border); }
  h1 { margin: 18px 0; font-size: clamp(42px, 7vw, 76px); letter-spacing: -.04em; }
  .guide-hero p:last-child { max-width: 58ch; color: var(--text-dim); font-size: 18px; }
  .guide-layout { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 48px; padding-top: 48px; padding-bottom: 80px; }
  aside { align-self: start; position: sticky; top: 94px; font-size: 13px; }
  aside p, .section-label { color: var(--text-faint); font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  aside nav { display: grid; gap: 12px; }
  .guide-content { min-width: 0; }
  section { padding-bottom: 36px; margin-bottom: 36px; border-bottom: 1px solid var(--border); scroll-margin-top: 94px; }
  h2 { font-size: clamp(24px, 3vw, 34px); letter-spacing: -.025em; }
  h3 { margin-top: 28px; font-size: 18px; }
  section p, section li { color: var(--text-dim); line-height: 1.7; }
  section li + li { margin-top: 8px; }
  section a { text-decoration: underline; text-underline-offset: 3px; }
  code { font: .88em var(--mono); overflow-wrap: anywhere; }
  .code-card { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .code-card :global(pre) { padding: 20px; margin: 0; overflow-x: auto; background: var(--code-bg) !important; font-size: 13px; line-height: 1.65; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
  td { color: var(--text-dim); min-width: 160px; }
  thead { background: var(--bg-elev); }
  @media (max-width: 800px) { .guide-layout { grid-template-columns: 1fr; gap: 28px; } aside { position: static; } aside nav { display: flex; flex-wrap: wrap; gap: 10px 20px; } }
</style>
