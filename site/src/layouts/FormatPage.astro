---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { formatSeo } from '../lib/seo';
interface Props {
  format: 'pptx' | 'docx' | 'xlsx';
  name: string;   // "PowerPoint"
  ext: string;    // ".pptx"
}
const { format, name, ext } = Astro.props;
const seo = formatSeo[format];
const fileNoun = { docx: 'Word document', xlsx: 'Excel workbook', pptx: 'PowerPoint deck' }[format];
---
<Base title={seo.title} description={seo.description} canonicalPath={`/${format}/`}>
  <Nav active={format} />

  <header class="fp-hero" data-format={format}>
    <div class="wrap">
      <a class="fp-back" href="/">← All formats</a>
      <p class="eyebrow">{name}</p>
      <h1 class="fp-title">{seo.heading}</h1>
      <p class="fp-lead">
        The examples below render a sample {fileNoun} (<code>{ext}</code>) in your browser and show
        the corresponding TypeScript.
      </p>
    </div>
  </header>

  <main class="wrap fp-main">
    <slot />
    <nav class="fp-reference" aria-label={`${name} reference`}>
      <a href={`/api/${format}`}>
        <span>API reference</span>
        <strong>Open the {name} API →</strong>
      </a>
    </nav>
  </main>

  <SiteFooter />

  <script>
    import { mountDemoInto, type DemoKind, type Format } from '../lib/demos';
    const base = import.meta.env.BASE_URL;
    const url = (fmt: string) => `${base}samples/sample-1.${fmt}`.replace(/([^:])\/\/+/g, '$1/');
    const vh = () => window.innerHeight || 800;

    const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-demo]'));
    const mountAll = new URLSearchParams(location.search).has('all');
    const mount = (el: HTMLElement) => {
      if (el.dataset.mounted) return;
      el.dataset.mounted = '1';
      mountDemoInto(el, el.dataset.demo as DemoKind, el.dataset.format as Format, url(el.dataset.format as string));
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { mount(e.target as HTMLElement); io.unobserve(e.target); }
    }, { rootMargin: '400px' });
    for (const el of blocks) {
      if (mountAll || el.getBoundingClientRect().top < vh() + 400) mount(el);
      else io.observe(el);
    }
  </script>
</Base>

<style>
  .fp-hero { padding: 40px 0 24px; border-bottom: 1px solid var(--border); }
  .fp-back { font-size: 13px; color: var(--text-faint); }
  .fp-back:hover { color: var(--text-dim); }
  .fp-hero[data-format='docx'] { --format-color: var(--docx); }
  .fp-hero[data-format='xlsx'] { --format-color: var(--xlsx); }
  .fp-hero[data-format='pptx'] { --format-color: var(--pptx); }
  .fp-hero .eyebrow {
    width: max-content;
    margin-top: 22px;
    color: var(--text);
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 700;
    background: linear-gradient(transparent 62%, var(--format-color) 62%, var(--format-color) 88%, transparent 88%);
  }
  .fp-ext { font-family: var(--mono); font-size: 12px; color: var(--text-faint); font-weight: 500; }
  .fp-title { font-size: clamp(28px, 5vw, 44px); font-weight: 800; letter-spacing: -0.02em; margin: 10px 0 0; }
  .fp-lead { margin: 16px 0 0; max-width: 70ch; font-size: 17px; color: var(--text-dim); }
  .fp-lead code { font-family: var(--mono); font-size: 0.9em; color: var(--text); }
  .fp-main { padding-bottom: 32px; }
  .fp-reference { padding: 32px 0 8px; border-top: 1px solid var(--border); }
  .fp-reference a {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 18px 20px; border: 1px solid var(--border); background: var(--panel);
  }
  .fp-reference span { color: var(--text-dim); font-size: 14px; }
  .fp-reference strong { color: var(--accent); }
</style>
