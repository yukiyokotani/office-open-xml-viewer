# Office fixture policy: see docs/sample-files.md.
# Office files and adjacent PDF references are ignored by default.
*.pptx
*.xlsx
*.docx
*.pdf

# Redistributable website demos (`sample-N`) and public tests (`test-N`).
# The directory exception covers Office files, adjacent PDFs, and documentation.
!packages/*/public/demo/
!packages/*/public/demo/**

# Non-redistributable fixtures and their PDFs stay local.
packages/*/public/private/

# OS metadata stays ignored even inside public fixture directories.
.DS_Store
**/.DS_Store
# Office Open XML spec documents
/spec
spec/
node_modules/
# Per-worktree pnpm store used by sandboxed/local agent sessions.
/.pnpm-store/
.claude/
dist/
# WASM build output (regenerate with: npm run wasm)
packages/pptx/src/wasm/
packages/pptx/parser/pkg/
packages/xlsx/src/wasm/
packages/docx/src/wasm/
# Pre-bundled MathJax asset (~3 MB minified IIFE; generated by
# packages/core/build/build-mathjax.mjs, run on install via core's `prepare`)
packages/core/assets/mathjax-stix2.js
# Rust build artifacts
target/
packages/xlsx/parser/target/
# Storybook build
storybook-static/
# Log files
*.log
# Visual regression test output (generated; not committed)
packages/pptx/tests/visual/screenshots/
packages/pptx/tests/visual/diffs/
packages/pptx/tests/visual/report/
packages/pptx/tests/visual/baseline/
# The VRT specs use package-relative output paths. When Playwright is invoked
# from the repository root, the same generated tree lands here instead.
/tests/visual/screenshots/
/tests/visual/diffs/
/tests/visual/report/
/tests/visual/baseline/
# Playwright
playwright-report/
test-results/
# Reference screenshots (not redistributable — private samples only)
packages/pptx/tests/visual/references/private/
# Local-only Storybook stories that load sample files
packages/pptx/src/*.privateDemo.stories.ts
packages/xlsx/src/*.privateDemo.stories.ts
packages/docx/src/*.privateDemo.stories.ts
# TypeScript build info
*.tsbuildinfo
# VS Code extension package output
*.vsix
# npm lockfile (using pnpm)
package-lock.json
# Per-session scratch notes (keep local, do not commit)
**/SESSION_LOG_*.md
**/PLAN_*.md
# Internal working docs — design specs, implementation plans (incl. superpowers
# skill output) and dev notes. Keep local; not for the public repo.
# (docs/images/ stays tracked — it holds the README / extension screenshots.)
docs/superpowers/
docs/dev-notes/
/.superpowers/
/tmp/
# Internal task list (Japanese dev notes); keep local, not for the public repo.
TODO.md

# Unicode bidi conformance fixtures (downloaded by the conformance test)
packages/core/src/text/bidi/__fixtures__/
