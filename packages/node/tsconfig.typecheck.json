{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@silurus/ooxml-core": ["../core/src/index.ts"],
      "@silurus/ooxml-core/worker": ["../core/src/worker/index.ts"],
      "@silurus/ooxml-pptx": ["../pptx/src/types.ts"],
      "@silurus/ooxml-pptx/internal/session": ["../pptx/src/internal/session.ts"],
      "@silurus/ooxml-docx": ["./typecheck/docx-public-types.ts"],
      "@silurus/ooxml-docx/internal/session": ["../docx/src/internal/session.ts"],
      "@silurus/ooxml-xlsx": ["../xlsx/src/types.ts"],
      "@silurus/ooxml-xlsx/internal/session": ["../xlsx/src/internal/session.ts"],
      "@silurus/ooxml-xlsx/internal/host-layout-measure": ["../xlsx/src/internal/host-layout-measure.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../pptx/src/types.ts",
    "../docx/src/types.ts",
    "../xlsx/src/types.ts",
    "../core/src/vite-env.d.ts",
    "typecheck/docx-public-types.ts"
  ]
}
