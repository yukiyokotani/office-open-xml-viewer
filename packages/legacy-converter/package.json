{
  "name": "@silurus/ooxml-legacy-converter",
  "private": true,
  "version": "0.85.3",
  "description": "Optional legacy Office (PPT) model sources for @silurus/ooxml",
  "license": "MIT",
  "author": "Yuki Yokotani <silurus.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukiyokotani/office-open-xml-viewer.git",
    "directory": "packages/legacy-converter"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./legacy-ppt": "./src/legacy-ppt.ts",
    "./legacy-ppt-source-module": "./src/legacy-ppt-source-module.ts",
    "./wasm-direct-ppt-binary": "./src/wasm-direct-ppt/legacy_ppt_direct_bg.wasm"
  },
  "scripts": {
    "wasm:direct-ppt": "cd parser && wasm-pack build --target web --out-dir ../src/wasm-direct-ppt --out-name legacy_ppt_direct --features direct-ppt && node ../../../scripts/append-wasm-reinit.mjs ../src/wasm-direct-ppt/legacy_ppt_direct.js",
    "typecheck": "tsc --noEmit",
    "survey": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@silurus/ooxml-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
